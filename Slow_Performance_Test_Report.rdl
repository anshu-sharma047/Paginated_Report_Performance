          <DataField>CustomerName</DataField>
        </Field>
        <Field Name="CustomerType">
          <DataField>CustomerType</DataField>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
        </Field>
        <Field Name="Email">
          <DataField>Email</DataField>
        </Field>
        <Field Name="Phone">
          <DataField>Phone</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
