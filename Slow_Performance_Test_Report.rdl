<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <rd:ReportID>22222222-2222-2222-2222-222222222222</rd:ReportID>
  <DataSources>
    <DataSource Name="SalesDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=YOUR_SQL_SERVER;Initial Catalog=PerformanceTestDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="Year">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>2025</Value>
        </Values>
      </DefaultValue>
      <Prompt>Year</Prompt>
    </ReportParameter>
    <ReportParameter Name="Region">
      <DataType>Text</DataType>
      <DefaultValue>
        <Values>
          <Value>All</Value>
        </Values>
      </DefaultValue>
      <Prompt>Region</Prompt>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="SalesDataset">
      <Query>
        <DataSourceName>SalesDB</DataSourceName>
        <CommandText>SELECT * FROM dbo.SalesTransactions WHERE YEAR(TransactionDate) = @Year</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="TransactionID">
          <DataField>TransactionID</DataField>
        </Field>
        <Field Name="TransactionDate">
          <DataField>TransactionDate</DataField>
        </Field>
        <Field Name="CustomerID">
          <DataField>CustomerID</DataField>
        </Field>
        <Field Name="ProductID">
          <DataField>ProductID</DataField>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
        </Field>
        <Field Name="SalesAmount">
          <DataField>SalesAmount</DataField>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
        </Field>
        <Field Name="Discount">
          <DataField>Discount</DataField>
        </Field>
        <Field Name="TaxAmount">
          <DataField>TaxAmount</DataField>
        </Field>
        <Field Name="ShippingAmount">
          <DataField>ShippingAmount</DataField>
        </Field>
        <Field Name="PaymentMethod">
          <DataField>PaymentMethod</DataField>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
        </Field>
        <Field Name="Notes">
          <DataField>Notes</DataField>
        </Field>
        <Field Name="CreatedBy">
          <DataField>CreatedBy</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TransactionsDataset">
      <Query>
        <DataSourceName>SalesDB</DataSourceName>
        <CommandText>SELECT * FROM dbo.SalesTransactions</CommandText>
      </Query>
      <Fields>
        <Field Name="TransactionID">
          <DataField>TransactionID</DataField>
        </Field>
        <Field Name="TransactionDate">
          <DataField>TransactionDate</DataField>
        </Field>
        <Field Name="CustomerID">
          <DataField>CustomerID</DataField>
        </Field>
        <Field Name="SalesAmount">
          <DataField>SalesAmount</DataField>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
        </Field>
        <Field Name="Notes">
          <DataField>Notes</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CustomerLookupDataset">
      <Query>
        <DataSourceName>SalesDB</DataSourceName>
        <CommandText>SELECT * FROM dbo.Customers</CommandText>
      </Query>
      <Fields>
        <Field Name="CustomerID">
          <DataField>CustomerID</DataField>
        </Field>
